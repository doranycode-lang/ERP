# Não introduzir credenciais nem dados clínicos neste ficheiro versionado.
# URL exacto do domínio público com HTTPS, sem barra final:
APP_ORIGIN=https://hospital.exemplo.ao
PORT=3000
HOSPITAL_DATABASE_FILE=./data/hospital.sqlite
NODE_ENV=production
